---
const roles = [
  {
    title: 'Data Scientist',
    company: 'QuantCo',
    period: 'Sep 2021 – present',
    location: 'Munich',
  },
  {
    title: 'Adjunct Lecturer (part time)',
    company: 'University of Cambridge',
    period: 'Oct 2024 – present',
    location: 'Cambridge (remote)',
  },
  {
    title: 'Data Analytics Intern',
    company: 'QuantCo',
    period: 'Jun – Sep 2019',
    location: 'Cologne',
  },
  {
    title: 'Summer Analyst',
    company: 'Frontier Economics',
    period: 'Jun – Aug 2017',
    location: 'Cologne',
  },
  {
    title: 'Summer Associate',
    company: 'Strategy&',
    period: 'Sep – Oct 2016',
    location: 'Munich',
  },
];

const education = [
  {
    degree: 'PhD in Economics',
    institution: 'University of Cambridge',
    period: '2017 – 2021',
  },
  {
    degree: 'MSc Engineering and Management',
    institution: 'Karlsruhe Institute of Technology',
    period: '2014 – 2017',
  },
  {
    degree: 'MSc Economics',
    institution: 'Universidad Carlos III de Madrid',
    period: '2015 – 2016',
  },
];
---

<section id="experience" class="fade-in-section py-20 bg-zinc-50/50 dark:bg-zinc-800/20">
  <div class="mx-auto max-w-4xl px-6">
    <div class="grid gap-16 md:grid-cols-2">
      <div>
        <h2 class="section-heading mb-8">Experience</h2>
        <div class="space-y-6">
          {roles.map((role) => (
            <div>
              <h3 class="text-sm font-medium text-zinc-900 dark:text-zinc-100">{role.title}</h3>
              <p class="text-sm text-zinc-500 dark:text-zinc-400">{role.company}</p>
              <p class="text-xs text-zinc-400 dark:text-zinc-500">{role.period} &middot; {role.location}</p>
            </div>
          ))}
        </div>
      </div>
      <div>
        <h2 class="section-heading mb-8">Education</h2>
        <div class="space-y-6">
          {education.map((edu) => (
            <div>
              <h3 class="text-sm font-medium text-zinc-900 dark:text-zinc-100">{edu.degree}</h3>
              <p class="text-sm text-zinc-500 dark:text-zinc-400">{edu.institution}</p>
              <p class="text-xs text-zinc-400 dark:text-zinc-500">{edu.period}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
