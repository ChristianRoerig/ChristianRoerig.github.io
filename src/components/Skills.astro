---
const skills = ['Python', 'R', 'Julia', 'SQL', 'Matlab', 'Stata'];
const interests = ['Macroeconomics', 'Firm Dynamics', 'Machine Learning', 'Causal Inference', 'Development Economics'];
---

<section class="py-20">
  <div class="mx-auto max-w-4xl px-6">
    <div class="grid gap-12 md:grid-cols-2">
      <div>
        <h2 class="section-heading mb-6">Tools</h2>
        <div class="flex flex-wrap gap-2">
          {skills.map((skill) => (
            <span class="rounded-full border border-zinc-200 px-3 py-1 text-xs text-zinc-600 dark:border-zinc-700 dark:text-zinc-400">
              {skill}
            </span>
          ))}
        </div>
      </div>
      <div>
        <h2 class="section-heading mb-6">Interests</h2>
        <div class="flex flex-wrap gap-2">
          {interests.map((interest) => (
            <span class="rounded-full border border-zinc-200 px-3 py-1 text-xs text-zinc-600 dark:border-zinc-700 dark:text-zinc-400">
              {interest}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
